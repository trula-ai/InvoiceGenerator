# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in the values. Never commit .env.local.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Drizzle ORM (lib/db.ts) and Drizzle Kit.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=

# Public base URL of the app (used in emails for links). No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email. Provider selection order: SMTP (when SMTP_HOST is set) -> Resend
# (when RESEND_API_KEY is set) -> console fallback that prints the message to
# the server log and records it with provider "console".
#
# SMTP relay (Gmail, Zoho, Outlook, SES, Mailgun, ...). For Gmail use
# smtp.gmail.com, port 587 and an App Password as SMTP_PASS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# "true" forces TLS from the first byte (port 465). Leave empty to infer from the port.
SMTP_SECURE=

# Resend (used only when SMTP_HOST is empty).
RESEND_API_KEY=
# Sender shown on every email, e.g. "Acme Billing <billing@yourdomain.com>".
# Falls back to SMTP_USER when empty.
EMAIL_FROM=

# Cloudflare Turnstile (bot protection on the sign-in form). Create a widget at
# https://dash.cloudflare.com -> Turnstile, add your domain (and "localhost" for
# development) and paste both keys. Leave empty to disable the check.
# Cloudflare's always-pass test keys for local development:
#   site   1x00000000000000000000AA
#   secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Due-date automation. Invoices due today with a balance get a reminder email
# and the in-app notification feed is refreshed. The dashboard runs this check
# itself at most once an hour; for guaranteed delivery call
# GET /api/cron/due-reminders daily (see vercel.json) with this bearer token.
CRON_SECRET=

# Exchange rates. Default provider is open.er-api.com (free, no key needed).
# Rates are cached in the database for this many hours.
EXCHANGE_RATE_CACHE_HOURS=12
